// =============================================================================
// Prisma Schema - OathPath
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// User & Identity
// =============================================================================

model User {
  id                      String   @id @default(uuid()) @db.Uuid
  email                   String   @unique
  displayName             String?  @map("display_name")
  providerDisplayName     String?  @map("provider_display_name")
  profileImageUrl         String?  @map("profile_image_url")
  providerProfileImageUrl String?  @map("provider_profile_image_url")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  identities             UserIdentity[]
  userRoles              UserRole[]
  userSettings           UserSettings?
  auditEvents            AuditEvent[]           @relation("ActorEvents")
  settingsUpdates        SystemSettings[]       @relation("SettingsUpdater")
  refreshTokens          RefreshToken[]         @relation("UserRefreshTokens")
  allowlistEntriesAdded  AllowedEmail[]         @relation("AllowlistAddedBy")
  allowlistEntry         AllowedEmail?          @relation("AllowlistClaimedBy")
  deviceCodes            DeviceCode[]           @relation("UserDeviceCodes")
  storageObjects         StorageObject[]        @relation("UserStorageObjects")
  personalAccessTokens   PersonalAccessToken[]  @relation("UserPersonalAccessTokens")
  credentialUpdates      Credential[]           @relation("CredentialUpdatedBy")
  notificationDeliveries NotificationDelivery[] @relation("UserNotificationDeliveries")
  notifications          Notification[]         @relation("UserNotifications")
  aiUsageEvents          AiUsageEvent[]         @relation("UserAiUsageEvents")
  learnerProfile         LearnerProfile?
  practiceSessions       PracticeSession[]      @relation("UserPracticeSessions")
  practiceAttempts       PracticeAttempt[]      @relation("UserPracticeAttempts")
  questionMastery        QuestionMastery[]      @relation("UserQuestionMastery")
  readinessSnapshots     ReadinessSnapshot[]    @relation("UserReadinessSnapshots")
  dailyActivity          DailyActivity[]        @relation("UserDailyActivity")
  mockInterviews         MockInterview[]        @relation("UserMockInterviews")

  @@map("users")
}

model UserIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String
  providerSubject String   @map("provider_subject")
  providerEmail   String?  @map("provider_email")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@map("user_identities")
}

// =============================================================================
// RBAC - Roles & Permissions
// =============================================================================

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  // Relations
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// =============================================================================
// Settings
// =============================================================================

model SystemSettings {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @unique
  value           Json
  version         Int      @default(1)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  updatedByUser User? @relation("SettingsUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model UserSettings {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  value     Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// =============================================================================
// Audit
// =============================================================================

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  actorUser User? @relation("ActorEvents", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_events")
}

// =============================================================================
// Refresh Tokens (for token rotation)
// =============================================================================

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  // Relations
  user User @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// =============================================================================
// Personal Access Tokens (PAT)
// =============================================================================

enum PatDurationUnit {
  minutes
  days
  months
}

model PersonalAccessToken {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  name          String
  tokenHash     String          @unique @map("token_hash")
  tokenPrefix   String          @map("token_prefix")
  durationValue Int             @map("duration_value")
  durationUnit  PatDurationUnit @map("duration_unit")
  expiresAt     DateTime        @map("expires_at") @db.Timestamptz
  lastUsedAt    DateTime?       @map("last_used_at") @db.Timestamptz
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  revokedAt     DateTime?       @map("revoked_at") @db.Timestamptz

  // Relations
  user User @relation("UserPersonalAccessTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("personal_access_tokens")
}

// =============================================================================
// Allowlist (Email Access Control)
// =============================================================================

model AllowedEmail {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique
  addedById   String?   @map("added_by_id") @db.Uuid
  addedAt     DateTime  @default(now()) @map("added_at") @db.Timestamptz
  claimedById String?   @unique @map("claimed_by_id") @db.Uuid
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz
  notes       String?

  // Relations
  addedBy   User? @relation("AllowlistAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  claimedBy User? @relation("AllowlistClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)

  @@map("allowed_emails")
}

// =============================================================================
// Device Authorization Flow (RFC 8628)
// =============================================================================

enum DeviceCodeStatus {
  pending
  approved
  denied
  expired
}

model DeviceCode {
  id         String           @id @default(uuid()) @db.Uuid
  deviceCode String           @unique @map("device_code")
  userCode   String           @unique @map("user_code")
  userId     String?          @map("user_id") @db.Uuid
  status     DeviceCodeStatus @default(pending)
  clientInfo Json?            @map("client_info")
  scopes     String[]
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User? @relation("UserDeviceCodes", fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceCode])
  @@index([userCode])
  @@index([status, expiresAt])
  @@index([userId])
  @@map("device_codes")
}

// =============================================================================
// Storage Objects
// =============================================================================

enum StorageObjectStatus {
  pending // Upload initiated, awaiting chunks
  uploading // Chunks being uploaded
  processing // Post-upload processing in progress
  ready // Available for use
  failed // Upload or processing failed
}

model StorageObject {
  id              String              @id @default(uuid()) @db.Uuid
  name            String // Original filename
  size            BigInt // Total size in bytes (BigInt for GB-scale)
  mimeType        String              @map("mime_type")
  storageKey      String              @unique @map("storage_key") // S3 object key
  storageProvider String              @default("s3") @map("storage_provider")
  bucket          String?
  status          StorageObjectStatus @default(pending)
  s3UploadId      String?             @map("s3_upload_id") // S3 multipart upload ID
  metadata        Json? // JSONB for flexible metadata
  uploadedById    String?             @map("uploaded_by_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  uploadedBy User?                @relation("UserStorageObjects", fields: [uploadedById], references: [id], onDelete: SetNull)
  chunks     StorageObjectChunk[]

  @@index([uploadedById])
  @@index([status])
  @@index([createdAt])
  @@map("storage_objects")
}

model StorageObjectChunk {
  id         String   @id @default(uuid()) @db.Uuid
  objectId   String   @map("object_id") @db.Uuid
  partNumber Int      @map("part_number") // S3 part number (1-10000)
  eTag       String   @map("e_tag") // S3 ETag for verification
  size       BigInt // Chunk size in bytes
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  // Relations
  object StorageObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([objectId, partNumber])
  @@index([objectId])
  @@map("storage_object_chunks")
}

// =============================================================================
// Encrypted Credential Store  (issue #115, epic #108)
// =============================================================================
//
// Runtime-configured secrets (an SMTP password, an OAuth client secret, a
// second bucket's S3 key, ...) addressed by (purpose, name) rather than one
// column per consumer, so every future secret reuses this table instead of
// inventing its own column, its own encrypt call, and its own chance to leak.
//
// `secret` holds ONLY the opaque base64 ciphertext produced by
// `encryptSecret()` in `common/crypto/secret-cipher.ts`, encrypted under
// `purpose` as the sub-key derivation label — a ciphertext lifted from one
// row cannot be decrypted under a different purpose. This model stores
// ciphertext and non-secret metadata only; it never sees plaintext, and
// Prisma performs no encryption of its own.
//
// NEVER select `secret` into anything that reaches an API response or a log
// line. `CredentialsService` is the sole reader/writer and is what actually
// enforces that split (a plaintext-returning method for server-side
// consumers, a metadata-only method for presentation) — this comment is the
// signpost, not the guarantee.
model Credential {
  id              String   @id @default(uuid()) @db.Uuid
  purpose         String
  name            String
  // Opaque [iv][authTag][ciphertext] payload, base64-encoded by
  // encryptSecret(). @db.Text (not the default `varchar`) because a base64
  // AES-GCM payload has no meaningful bound: encrypted key material,
  // passwords, or tokens of arbitrary length must never be truncated.
  secret          String   @db.Text
  // Non-secret display aid for the admin UI (e.g. last 4 chars, or a fixed
  // mask like '••••'). Nullable: a credential can exist before anyone has
  // decided how to hint it, and some secrets have no meaningful suffix to show.
  hint            String?
  // Human-readable description for the admin UI. Nullable for the same reason.
  label           String?
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  //
  // onDelete: SetNull — deliberately NOT Cascade. A credential is
  // infrastructure shared by whatever consumer looks it up by (purpose,
  // name); the admin who last set it is provenance, not an owner the
  // credential's lifetime should depend on. Offboarding the user who last
  // typed in the SMTP password must not silently delete a working SMTP
  // configuration — that failure mode (email breaks because someone left
  // the company) is exactly what this FK behaviour avoids. The credential
  // outliving its last editor is correct; losing it is not.
  updatedByUser User? @relation("CredentialUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([purpose, name])
  @@map("credentials")
}

// =============================================================================
// Notification Deliveries (issue #125, epic #109)
// =============================================================================
//
// One row per delivery ATTEMPT of an event (#121, `notification-events.ts`)
// over a channel, to a recipient. This is the answer to "did the user
// actually get it?" — the first question asked when something goes wrong,
// and epic #109's own success criterion 7: a delivery record exists for
// every attempt, with the provider's message id or error.
//
// -----------------------------------------------------------------------------
// eventKey — plain string, NOT a foreign key
// -----------------------------------------------------------------------------
// Events are declared in code (`notification-events.ts`, #121), not in a
// database table — `findEvent()` there returns `undefined` rather than
// throwing for a key it doesn't recognize, precisely because callers may be
// holding a key that came from persisted data written before the event was
// renamed or removed. An FK into an "events" table would force a migration
// (and a backfill, or a placeholder row) every time the registry changes,
// which is exactly the coupling #121 built the registry to avoid. A delivery
// record must outlive the event definition that produced it.
//
// -----------------------------------------------------------------------------
// channel — ALSO a plain string, not a Prisma enum (deliberately asymmetric
// with `status` below)
// -----------------------------------------------------------------------------
// `NotificationChannel` in `notification-events.ts` is explicitly derived
// from a plain array (`NOTIFICATION_CHANNELS`) so that adding `'push'` later
// (epic #109 reserves it) costs one edit to that array, not a migration. A
// Postgres enum on this column would quietly reintroduce that migration: the
// set of valid channels would live in two places — the code registry and
// this column's type — and adding one would require updating both. The
// registry is the single source of truth for what channels exist; this
// column just records which one a given attempt used.
//
// -----------------------------------------------------------------------------
// status — IS a Prisma enum
// -----------------------------------------------------------------------------
// Unlike eventKey/channel, `status` is not registry data — it is this
// table's own delivery state machine, owned entirely by the dispatcher, and
// nothing outside this table grows it. It follows the convention this schema
// already uses for exactly this shape of field (`DeviceCodeStatus`,
// `StorageObjectStatus`): a small, closed, code-owned set of states is a
// Postgres enum here, so the database itself rejects a delivery row written
// with anything other than queued/sent/failed.
//
// -----------------------------------------------------------------------------
// userId — nullable; recipient — the actual destination used
// -----------------------------------------------------------------------------
// `allowlist.invitation` (#121) is sent to an email address with no user
// account yet (#128) — there is no user row to point to, so `userId` must be
// nullable. `recipient` is what makes that case complete: it is the actual
// destination address used for THIS delivery, captured independently of the
// user relation, so the record stands on its own with `userId` null, and
// stays historically accurate even if the user's email later changes.
//
// -----------------------------------------------------------------------------
// onDelete: SetNull on the user relation
// -----------------------------------------------------------------------------
// Matches the audit-trail precedent this schema already sets for
// `AuditEvent.actorUserId` and `Credential.updatedByUser`: a delivery record
// is a history of what the application sent, and deleting a user account
// should not retroactively erase the evidence of what was sent to them —
// particularly for `security.*` events (#121), which are exactly the ones an
// incident review is most likely to need after the account in question no
// longer exists. Nothing is lost by nulling the FK: `recipient` already
// carries the actual destination independently of it. A GDPR-style request
// to purge one user's PII is a deliberate, targeted scrub of these rows (and
// `recipient` specifically) — not something an ON DELETE clause should do
// silently and irreversibly as a side effect of an unrelated user-deletion
// path elsewhere in the app.
//
// -----------------------------------------------------------------------------
// Indexes — exactly the two queries this table is known to serve
// -----------------------------------------------------------------------------
// Every index is a write cost on a table that grows with every notification
// sent, so nothing speculative is added beyond what #125 itself names:
//   - [userId, eventKey]: "did this user get this event?" — an equality
//     filter on both columns, from an account's delivery history view.
//   - [status, createdAt]: "what failed recently?" — status = 'failed'
//     filtered and ordered by recency, for on-call triage.
model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  eventKey          String                     @map("event_key")
  userId            String?                    @map("user_id") @db.Uuid
  recipient         String
  channel           String
  status            NotificationDeliveryStatus @default(queued)
  providerMessageId String?                    @map("provider_message_id")
  // Provider errors (SMTP rejections, SES API errors, ...) have no useful
  // length bound — @db.Text, same reasoning as Credential.secret above.
  error             String?                    @db.Text
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User? @relation("UserNotificationDeliveries", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, eventKey])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

enum NotificationDeliveryStatus {
  queued
  sent
  failed
}

// =============================================================================
// Notifications — the in-app notification centre store (issue #127, epic #109)
// =============================================================================
//
// THE PRIMARY SURFACE OF THE BROWSER CHANNEL, NOT A CACHE OF WHAT SSE SENT.
//
// That ordering is the whole reason this table exists. `Notification`
// permission is denied by a large share of users, and once denied it is
// effectively permanent — the page cannot re-prompt. A browser channel that
// existed only as an OS toast would therefore not exist at all for those
// accounts. So the durable, per-user list is the feature; the SSE stream
// (`notification-stream.service.ts`) makes it live, and the native toast is a
// decoration on top that degrades to nothing.
//
// Read the second consequence too: SSE IS NOT A DELIVERY GUARANTEE. Events
// published while a tab is disconnected are lost — `EventSource` reconnects
// but replays nothing, and the per-process subscriber registry does not fan
// out across replicas. Because rows land here first and the stream is
// published second, a client that refetches this table on (re)connect sees
// everything regardless. That is the designed recovery path, and it is why
// there is no event-replay machinery anywhere in #127.
//
// -----------------------------------------------------------------------------
// HOW THIS DIFFERS FROM `notification_deliveries` (#125), WHICH IS NOT THE SAME
// TABLE WITH A DIFFERENT NAME
// -----------------------------------------------------------------------------
//
// `notification_deliveries` is the OPERATOR's record: one row per ATTEMPT, per
// channel, answering "did we try, and what did the provider say?". It records
// email attempts too, it keeps rows for recipients with no account, and it is
// never shown to the user it is about.
//
// `notifications` is the USER's inbox: one row per thing they should see, only
// for the browser channel, only for real accounts, with read state they own.
// An email send writes a delivery row and no row here — there is nothing for
// the bell to show about a message that went to their mailbox.
//
// Merging the two would mean either showing users provider error strings, or
// filtering an operator table by channel on every bell render. They answer
// different questions for different audiences and are kept apart.
// =============================================================================

model Notification {
  id     String @id @default(uuid()) @db.Uuid
  // NOT NULL, unlike NotificationDelivery.userId. An inbox belongs to an
  // account by definition; there is no "notification centre" for a recipient
  // with no login (#128's `allowlist.invitation` case), which is exactly why
  // the browser channel's resolveTo returns null for them.
  userId String @map("user_id") @db.Uuid

  // Plain string, NOT a foreign key — the same reasoning written out at length
  // on NotificationDelivery.eventKey. Events are declared in code
  // (`notification-events.ts`, #121) and `findEvent` returns undefined rather
  // than throwing precisely because persisted rows outlive their definitions.
  // An FK would force a migration every time the registry changed.
  eventKey String @map("event_key")

  // RENDERED AT WRITE TIME, not at read time. The alternative — store the
  // event payload as JSONB and render in the bell — means an old row renders
  // through today's template, so editing copy silently rewrites history and a
  // removed event's rows become unrenderable. What the user was told is a
  // fact; it is frozen here.
  title String
  // @db.Text for the same reason as Credential.secret and
  // NotificationDelivery.error: a rendered body has no meaningful length
  // bound, and silently truncating what a user was told is worse than storing
  // a long string. (Postgres `text` has no performance penalty over `varchar`.)
  body  String @db.Text

  // Where the bell should send the user, as a ROOT-RELATIVE PATH ("/settings",
  // "/admin/users?id=…"), never an absolute URL.
  //
  // THIS IS A SECURITY BOUNDARY, ENFORCED IN CODE AT WRITE TIME
  // (`browser-notification.channel.ts`). The web client will put this value in
  // an href or a router navigation; an absolute URL makes every notification a
  // potential open redirect, and a `javascript:` scheme makes it script
  // execution in the app's own origin. The column cannot express that
  // constraint, so the writer enforces it and drops a link it cannot vouch
  // for rather than storing it and hoping the client is careful.
  //
  // Nullable: most notifications have nowhere specific to go.
  link String?

  // A TIMESTAMP, NOT A BOOLEAN. `readAt IS NULL` answers "is it unread?" just
  // as well as `read = false` does, and additionally answers "when did they
  // see it?" — which is the question asked when someone reports acting late on
  // a security alert. A boolean would have to grow this column later anyway.
  readAt DateTime? @map("read_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // NO `updatedAt`. The only mutation this row ever undergoes is being marked
  // read, and `readAt` already timestamps that with more precision than an
  // `updatedAt` would carry. A second, redundant answer to "when did this
  // change?" is a second thing to keep consistent for no reader.

  // Relations
  //
  // onDelete: Cascade — deliberately the OPPOSITE of
  // NotificationDelivery.user's SetNull, and the contrast is the point. A
  // delivery record is an audit trail that must outlive the account it
  // describes ("did we email this person before they were offboarded?"). An
  // inbox is personal data with no reader once the account is gone: keeping
  // orphaned rows would retain rendered titles and bodies about a deleted user
  // forever, and `userId` is NOT NULL here so SetNull is not even expressible.
  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  // The two queries this table actually serves, and nothing speculative.
  //
  // 1. THE UNREAD BADGE: `where { userId, readAt: null }`, run on every bell
  //    render and on every SSE (re)connect — by far the hottest query here.
  //    (Ideally a partial index `WHERE read_at IS NULL`, which Prisma cannot
  //    express declaratively; the composite covers the same predicate and
  //    stays in one place the schema owns.)
  @@index([userId, readAt])
  // 2. THE RECENT LIST: `where { userId } orderBy { createdAt: desc }`.
  //    `sort: Desc` matters — a plain ascending index makes Postgres walk it
  //    backwards for the newest page, which is the only page anyone loads.
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// =============================================================================
// AI Usage Events (issue #34, epic #25)
// =============================================================================
//
// One row per AI call, written by `BaseAiProvider` (#37) on success and on
// failure alike.
//
// WHY THIS TABLE EXISTS AT ALL: every user brings their own OpenAI key and
// pays for their own consumption (epic #25, decision 4). Per-user visibility
// is the entire reason BYOK was chosen over a shared server key — without it,
// a user has no way to see what the app is costing them, and the trade made in
// #25 buys nothing.
//
// -----------------------------------------------------------------------------
// WHAT IS NOT HERE, AND WILL NOT BE
// -----------------------------------------------------------------------------
//
// No prompt text, no completion text, no API key, no key hint. Token counts
// and metadata only. This table is written on EVERY AI call, so it is the
// highest-volume place in the schema; a column holding what a learner typed
// during interview practice would make it the most sensitive one too, for a
// reader that does not exist. #37's own tests assert the absence.
//
// -----------------------------------------------------------------------------
// THIS IS RECORDED USAGE, NOT A BILL
// -----------------------------------------------------------------------------
//
// Token counts are not dollars, a call that fails mid-stream records nothing,
// and the authoritative number is the user's own OpenAI dashboard. #42's page
// says so on screen. Nothing downstream may present a sum of these columns as
// an amount owed.
// =============================================================================

model AiUsageEvent {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Which provider actually served the call, and which model.
  //
  // PLAIN STRINGS, NOT ENUMS OR FOREIGN KEYS, for the same reason
  // `NotificationDelivery.eventKey` is: `AI_PROVIDER_KINDS` and the model
  // catalog live in code and at the provider respectively, not in a table. A
  // usage record must outlive the binding that produced it — an admin who
  // rebinds `grader` to a different model must not retroactively change what
  // last month's rows say ran.
  provider String
  model    String

  // The role the call served: 'tutor', 'grader', … See
  // `apps/api/src/ai/ai-model-roles.ts`. A plain string for the same reason,
  // and because a decommissioned role's historical rows must still read
  // correctly.
  roleKey String @map("role_key")

  // ---------------------------------------------------------------------------
  // Token counts — NULLABLE, AND THAT IS THE WHOLE DESIGN
  // ---------------------------------------------------------------------------
  //
  // A call that fails mid-stream yields partial or no usage. Writing `0` there
  // would be a CLAIM — a false one that quietly understates consumption, and
  // the understatement is invisible because zero is a perfectly plausible
  // value. NULL means "unknown"; `success` and `errorCode` are what
  // distinguish it from a call that genuinely consumed nothing.
  //
  // Also null for a streamed response whose request omitted
  // `stream_options: { include_usage: true }` — OpenAI emits usage only when
  // that flag is set, which is the most likely way this feature ends up
  // silently wrong. #37 asserts the flag rather than trusting it.
  promptTokens     Int? @map("prompt_tokens")
  completionTokens Int? @map("completion_tokens")
  totalTokens      Int? @map("total_tokens")

  // Wall-clock duration of the call. Null when the call never started (a
  // configuration refusal recorded for completeness).
  latencyMs Int? @map("latency_ms")

  // Did the provider complete the call?
  //
  // NOT DERIVABLE FROM THE TOKEN COLUMNS. A successful call can report no
  // usage, and a failed one can report partial usage; this is the independent
  // fact, and it is what makes the nullability above readable.
  success Boolean

  // A short, stable classification of the failure — 'rate_limit',
  // 'invalid_key', 'model_not_found', 'timeout'. Null on success.
  //
  // A CODE, NOT THE PROVIDER'S MESSAGE. The message is verbatim provider text
  // that may quote a request; this column is written on every failed call and
  // is meant to be GROUPed by, which a free-text message cannot be. The
  // diagnosable text belongs in a log line and in the test endpoints' response,
  // both of which are redacted paths.
  errorCode String? @map("error_code")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // NO `updatedAt`. A usage event is an immutable record of something that
  // already happened; nothing rewrites one, and a column implying otherwise
  // would be a second answer to "when" for no reader.

  // Relations
  //
  // onDelete: Cascade — DELIBERATELY UNLIKE `Credential`, which has no user
  // relation at all and whose missing FK is the defect #38 exists to work
  // around. Usage rows are the user's own data with no reader once the account
  // is gone, `userId` is NOT NULL so SetNull is not expressible, and retaining
  // a deleted person's consumption history serves nobody. Same reasoning as
  // `Notification.user`.
  user User @relation("UserAiUsageEvents", fields: [userId], references: [id], onDelete: Cascade)

  // Back-relation for `PracticeAttempt.aiUsageEventId` (issue #110, epic #53)
  // — the grading calls this usage event recorded. No `onDelete` to set here:
  // the FK and its `SetNull` behavior live on `PracticeAttempt`, the owning
  // side; deleting a usage row nulls out the attempts that pointed to it
  // rather than deleting them, matching that column's own comment.
  practiceAttempts PracticeAttempt[] @relation("AiUsageEventPracticeAttempts")

  // The one query the UI actually makes: this user's events, newest first,
  // over a time window (#37's GET /api/ai/usage).
  //
  // `sort: Desc` matters — a plain ascending index makes Postgres walk it
  // backwards for the newest page, which is the only page anyone loads. The
  // composite also serves the by-model and by-role breakdowns, which filter on
  // the same leading `userId` before grouping.
  @@index([userId, createdAt(sort: Desc)])
  @@map("ai_usage_events")
}

// =============================================================================
// Journey Shell: Learner Profile & Civics Test Versions (issue #62, epic #50)
// =============================================================================
//
// Full design: docs/specs/journey-shell.md §3. This comment is the pointer,
// not a restatement — read that section (and §11's rejected alternatives)
// before changing anything here.

// -----------------------------------------------------------------------------
// stage — a REAL Postgres enum, unlike `NotificationDelivery.eventKey` or
// `AiUsageEvent.roleKey`/`provider`/`model`, which are all plain strings on
// purpose.
// -----------------------------------------------------------------------------
//
// Those columns are open sets a code registry is meant to extend with no
// migration, and a historical row must keep reading correctly after the
// registry entry that produced it is renamed or removed. The eight journey
// stages are the opposite: `VISION.md`'s named, CLOSED sequence. A ninth
// stage is a product decision on the order of rewriting the journey model,
// not a routine registry addition — it should cost the migration a real enum
// requires, and the database should refuse a value no stage machine emits
// rather than accept whatever an application bug happens to write.
// journey-shell.md §1, §3.2, §11.
enum JourneyStage {
  uncertain
  oriented
  learning
  remembering
  speaking
  practicing
  performing
  ready
}

// A lookup table with real, seeded content-shape rows — not a settings
// value, because `LearnerProfile.testVersionCode` needs a foreign key target,
// and E8's interview engine reads pass rules FROM A ROW, not from a constant
// duplicated at each call site. journey-shell.md §3.1.
//
// `code` is a real primary key, not a Prisma enum: the seed already gives
// referential integrity through the foreign key, and a future test revision
// is a row insert here, not a schema-level `ALTER TYPE`.
model CivicsTestVersion {
  code  String @id
  label String

  questionsAsked       Int @map("questions_asked")
  passThreshold        Int @map("pass_threshold")
  seniorQuestionsAsked Int @map("senior_questions_asked")
  seniorPassThreshold  Int @map("senior_pass_threshold")

  // Nullable — populated once E2 loads the versioned, provenance-tracked
  // question content and hashes it. Null immediately after E1's seed,
  // because E1 seeds the test-version *shape*, not the question bank.
  contentHash String? @map("content_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  learnerProfiles  LearnerProfile[]
  categories       CivicsCategory[]
  questions        CivicsQuestion[]
  practiceSessions PracticeSession[]
  mockInterviews   MockInterview[]

  @@map("civics_test_versions")
}

// One row per user, created at account creation (or lazily on first
// orientation read) with every field at its default until orientation is
// completed. Shape mirrors `UserSettings`'s `userId @unique … onDelete:
// Cascade` pattern above. journey-shell.md §3.2.
model LearnerProfile {
  id String @id @default(uuid()) @db.Uuid

  // One profile per user; deleting the user deletes the profile — this IS a
  // real foreign key (unlike `Credential`'s `(purpose, name)` address), so
  // there is no orphaned-row hazard to design around.
  userId String @unique @map("user_id") @db.Uuid

  stage JourneyStage @default(uncertain)

  // A calendar date, not a moment — an interview is booked for a day, not an
  // instant, and shifting the learner's `timezone` later must not silently
  // move which day this is. `@db.Date`, deliberately not `@db.Timestamptz`.
  interviewDate DateTime? @map("interview_date") @db.Date

  // Nullable until orientation. MUST admit `DC`, `PR`, `GU`, `VI`, `AS`, `MP`
  // alongside the 50 states — the 2008 test's accepted answer for "who are
  // your state's senators" covers residents of these territories explicitly
  // (they have none), so this column has to hold a real value for them from
  // day one. See `apps/api/src/common/constants/us-states.constants.ts`.
  stateCode String? @map("state_code") @db.Char(2)

  // Nullable, and null means "not yet resolved" — not knowable before the
  // learner supplies a filing date, so a non-null column would force a
  // default onto every profile that is an unverified claim about that
  // learner (§10's honesty rule). Resolved once, at orientation submit time,
  // from the filing date the learner enters — never recomputed live.
  // `onDelete: Restrict` — a test version cannot be deleted while any
  // profile still references it.
  testVersionCode String? @map("test_version_code")

  seniorExemption Boolean @default(false) @map("senior_exemption")

  // "Five minutes should matter" is the product's stated floor, not a
  // placeholder default nobody chose on purpose.
  dailyGoalMinutes Int @default(5) @map("daily_goal_minutes")

  // A BCP-47 tag. Governs only AI *explanations* — localizing the
  // application chrome itself is out of scope; questions and official
  // answers stay in English.
  explanationLanguage String @default("en") @map("explanation_language")

  // An IANA zone name, captured at orientation (from the browser,
  // confirmable by the learner). Default is `UTC`, not null: a lazily
  // created profile still needs a defined zone for E7's local-day rule, and
  // `UTC` is the honest "nobody has told us yet" value that orientation
  // replaces — unlike `stateCode` or `testVersionCode`, there is no learner
  // claim being fabricated here, since every instant genuinely does fall on
  // some UTC calendar day.
  timezone String @default("UTC")

  // Null until orientation is submitted. This is the literal field
  // `RequireOrientation` checks.
  orientationCompletedAt DateTime? @map("orientation_completed_at") @db.Timestamptz

  // ---------------------------------------------------------------------------
  // Streak Freezes (issue #112, epic #56 "Habit")
  // ---------------------------------------------------------------------------
  // How many streak freezes this learner currently HOLDS — a freeze is spent
  // by settlement writing a `DailyActivity` row with `freezeUsed: true` for a
  // day the learner did not actually practise, so a single missed day does
  // not reset a streak the same way `distinctCorrectDays` (`QuestionMastery`'s
  // own comment) refuses to let one lucky session fabricate mastery. Default
  // `2`, and that default is not just "a reasonable starting balance for a
  // brand-new row" — it is what an `ALTER TABLE ... ADD COLUMN` writes into
  // every LearnerProfile row that already exists at migration time. The
  // product's stated posture is protection, not scarcity (VISION.md), so an
  // existing learner mid-streak the day this ships starts protected, exactly
  // like a learner who signs up tomorrow.
  streakFreezes Int @default(2) @map("streak_freezes")

  // When the freeze budget was last topped up. Nullable, and null is a real,
  // distinct state — "never replenished" — not "replenished at some unknown
  // time": the accrual service treats null as eligible-for-replenishment on
  // sight, with no sentinel epoch value to special-case. Every row that
  // exists before this migration is null for the same honest reason
  // `LearnerProfile.testVersionCode` starts null (§10's honesty rule,
  // referenced on that field above) — nothing here has actually happened yet,
  // so nothing should claim it has.
  streakFreezesGrantedAt DateTime? @map("streak_freezes_granted_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  testVersion CivicsTestVersion? @relation(fields: [testVersionCode], references: [code], onDelete: Restrict)

  @@index([testVersionCode])
  @@map("learner_profiles")
}

// =============================================================================
// Civics Content: Categories, Questions & Answers (issue #97, epic #51)
// =============================================================================
//
// The versioned question bank `LearnerProfile.testVersionCode` and
// `CivicsTestVersion` above already anticipate: E1 seeded the test-version
// *shape* (question counts, pass thresholds) with `contentHash` left null
// until this content actually exists. This is that content. Loading it (a
// seed/import script reading real USCIS question data) is explicitly OUT of
// scope for #97 — these three tables define the shape only.
//
// No relation to `users` anywhere in this block: content is code-owned and
// admin/seed-loaded, not user-owned, so there is nothing here for a user
// deletion to cascade into.

// A CLOSED, code-owned set — the dynamic-answer lifecycle a question can
// have, not an open registry a feature module extends. `none` covers the
// vast majority of questions (fixed answers, e.g. "How many amendments does
// the Constitution have?"); `national` is a single fact that changes at the
// federal level (President, Vice President, Speaker of the House);
// `state` varies per state/territory (state capital, governor, U.S.
// Representative). A Postgres enum, matching this schema's convention for
// exactly this shape of field (`JourneyStage`, `StorageObjectStatus`,
// `DeviceCodeStatus`): the database should reject a value the loader and the
// interview engine don't both already know how to handle.
enum CivicsDynamicScope {
  none
  national
  state
}

// One row per (test version, category) — e.g. "AMERICAN GOVERNMENT / System
// of Government" under the 2008 test. `section` and `code` mirror the
// official USCIS category structure so a future loader can address a
// category by the same keys the source material uses, without inventing its
// own numbering.
model CivicsCategory {
  id String @id @default(uuid()) @db.Uuid

  // onDelete: Restrict, matching `LearnerProfile.testVersion` above — a test
  // version cannot be deleted while its categories still exist.
  testVersionCode String @map("test_version_code")

  section   String
  code      String
  name      String
  sortOrder Int    @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  testVersion      CivicsTestVersion @relation(fields: [testVersionCode], references: [code], onDelete: Restrict)
  questions        CivicsQuestion[]
  practiceSessions PracticeSession[]

  // A category is addressed by its own code within one test version — 2008
  // and 2025 can each freely define (or redefine) the same `code`.
  @@unique([testVersionCode, code])
  @@map("civics_categories")
}

// One row per official question, scoped to a test version. `number` is the
// question's official ordinal within that version (e.g. #1-#100 on the 2008
// test) — NOT a global id, which is exactly why the uniqueness guarantee
// below is scoped to `testVersionCode` and not `number` alone.
model CivicsQuestion {
  id String @id @default(uuid()) @db.Uuid

  // onDelete: Restrict — same reasoning as `CivicsCategory.testVersion`.
  testVersionCode String @map("test_version_code")

  number Int

  // onDelete: Restrict, per #97: deleting a category is BLOCKED while
  // questions still reference it, so a category can only be removed once it
  // is empty.
  categoryId String @map("category_id") @db.Uuid

  prompt String

  // Whether this question is among the 20 an applicant aged 65+ with 20
  // years of permanent residency may study exclusively (the "20/65" senior
  // exemption `LearnerProfile.seniorExemption` already tracks).
  seniorEligible Boolean @map("senior_eligible")

  dynamicScope CivicsDynamicScope @default(none) @map("dynamic_scope")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  testVersion CivicsTestVersion @relation(fields: [testVersionCode], references: [code], onDelete: Restrict)
  category    CivicsCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  answers     CivicsAnswer[]
  attempts    PracticeAttempt[]
  mastery     QuestionMastery[]

  // Reverse lookup for `MockInterviewTurn.questionId` (issue #115, epic
  // #57) — the officer-turn "which question was read" reference. Same
  // "content the schema cares about protecting" posture as `attempts`
  // above: an already-asked interview question cannot be deleted.
  mockInterviewTurns MockInterviewTurn[]

  // The seed loader's stable upsert key: re-running a loader against the same
  // (version, official number) must resolve to the same row, never create a
  // duplicate.
  @@unique([testVersionCode, number])
  @@index([categoryId])
  @@map("civics_questions")
}

// One row per accepted answer to a question. Many USCIS questions have
// multiple simultaneously-correct answers ("Name one branch of government" →
// legislative / executive / judicial) — that is what `sort` orders — and a
// `dynamicScope: national` or `state` question's answer set changes over
// time as officeholders change, which is what `stateCode`,
// `effectiveFrom`/`effectiveTo` and `verifiedAt` exist to track.
//
// -----------------------------------------------------------------------------
// THE PARTIAL UNIQUE INDEX LIVES ONLY IN THE MIGRATION, NOT HERE
// -----------------------------------------------------------------------------
// Following the same convention `Notification`'s comment above documents for
// its own (unbuilt) partial index: Prisma's schema language cannot express a
// partial index (a `WHERE` clause) or an expression index (a function over a
// column) declaratively, so `civics_answers_open_slot_unique` is hand-added
// to this table's migration.sql and is invisible here. It enforces, for every
// question: at most one OPEN (`effective_to IS NULL`) answer per
// `(state_code, sort)` slot — where a national answer's `state_code IS NULL`
// is folded to `''` via `COALESCE` specifically so it is constrained too
// (Postgres treats two NULLs as distinct in a unique index, which would
// otherwise leave national dynamic answers, e.g. President, Speaker,
// completely unconstrained — exactly the rows this lifecycle most needs to
// keep singular). Regenerating this schema from the database will NOT
// reproduce that index; see the migration for the exact DDL and reasoning.
model CivicsAnswer {
  id String @id @default(uuid()) @db.Uuid

  // onDelete: Cascade — deliberately UNLIKE every `Restrict` relation
  // elsewhere in this block. An answer has no identity independent of its
  // question; removing the question should remove its answers, the same way
  // `UserIdentity.user` and `LearnerProfile.user` cascade from their owning
  // row.
  questionId String @map("question_id") @db.Uuid

  text String

  // Orders multiple simultaneously-correct answers to the same question, and
  // is one leg of the partial unique index above.
  sort Int

  // Null for a question with no per-state variation (`dynamicScope: none` or
  // `national`). @db.Char(2), matching `LearnerProfile.stateCode` — MUST
  // admit `DC`, `PR`, `GU`, `VI`, `AS`, `MP` alongside the 50 states, per the
  // same constants file that field's comment names.
  stateCode String? @map("state_code") @db.Char(2)

  // When a human last confirmed this answer against the authoritative source
  // (e.g. the current officeholder). Distinct from `effectiveFrom`: a fact
  // can be re-verified without its effective date changing.
  verifiedAt DateTime @map("verified_at") @db.Timestamptz

  // The instant this answer became correct. For a `dynamicScope: none`
  // question this is simply when the row was authored.
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz

  // Null means "still correct" (an OPEN row) — the value the partial index
  // above filters on. Set once a dynamic answer is superseded (a new
  // President is sworn in), closing this row without deleting it, so the
  // interview engine can still explain what was correct on a past date.
  effectiveTo DateTime? @map("effective_to") @db.Timestamptz

  // Free-text provenance for the verification above (e.g. a citation or URL).
  // @db.Text is not used here — unlike `Credential.secret` or
  // `NotificationDelivery.error`, this is short admin-authored commentary,
  // not provider output or ciphertext with no natural bound.
  sourceNote String? @map("source_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  question CivicsQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("civics_answers")
}

// =============================================================================
// Practice Sessions & Attempts (issue #66, epic #52)
// =============================================================================
//
// The evidence ledger PRD.md's readiness model runs on. VISION.md is explicit
// that OathPath "should never create artificial confidence after a few
// successful questions" — readiness has to be reconstructed from repeated,
// timestamped evidence, not read off a single mutable "score" column. These
// two tables ARE that evidence: `PracticeSession` groups a run of practice
// into one unit (a quick drill, a category focus, a weak-question review...),
// and `PracticeAttempt` is one row per question answered, ever, regardless of
// which (if any) session it belonged to.
//
// -----------------------------------------------------------------------------
// WHY `PracticeAttempt` DOES NOT LIVE UNDER `PracticeSession` ALONE
// -----------------------------------------------------------------------------
// A naive design nests attempts inside sessions and stops there. That breaks
// the moment E8's mock-interview engine exists: a mock interview asks
// questions too, and its answers are exactly the same kind of evidence
// ("has this learner demonstrated recall of this question?") the readiness
// model needs to fold in alongside ordinary practice. Rather than a second,
// parallel "mock_interview_attempts" table the readiness query would have to
// UNION against this one, `PracticeAttempt.sessionId` is nullable and
// `source` distinguishes the two origins on the SAME table. One evidence
// table, one readiness query, one place a future "did they ever answer this
// question correctly" check has to look.
//
// -----------------------------------------------------------------------------
// FOUR COLUMNS THIS EPIC WRITES ONLY ONE VALUE OF, ON PURPOSE
// -----------------------------------------------------------------------------
// `source`, `promptMode`, `inputMode` and `hintUsed` are all real, typed
// columns today even though E3 (this epic) only ever writes
// `practice`/`read`/`typed`/`false` into them. Each is a documented future
// reader, not a speculative one:
//   - `source: mock_interview` — E8's realistic mock interviews (PRD.md:
//     "performance in realistic mock interviews") write attempts through this
//     same table with `source: mock_interview` and `sessionId: null`. Adding
//     the value later would mean widening an enum AND retrofitting every
//     historical row's assumed source — cheaper to declare the full set now
//     while the table is empty.
//   - `promptMode: heard` / `inputMode: spoken` — E9's spoken-answer practice
//     (PRD.md: "spoken-answer practice", "ability to recall answers without
//     hints" alongside "understand questions when they are spoken") is a
//     DIFFERENT kind of evidence than reading a question and typing an
//     answer — VISION.md lists retrieval, spoken response, and interview
//     performance as distinct signals, not interchangeable ones. A readiness
//     model that cannot tell a typed/read attempt from a spoken/heard one
//     cannot honor that distinction, so the columns exist from the first
//     attempt row ever written, not backfilled once E9 ships and every prior
//     row has to be assumed to be `typed`/`read` after the fact.
//   - `hintUsed` — PRD.md names "ability to recall answers without hints" as
//     its own readiness signal, independent of whether the attempt was
//     ultimately correct. A learner who reveals the answer before typing it
//     and a learner who recalls it cold both may end up `outcome: correct`;
//     only this column tells them apart. Recording it from day one avoids a
//     hole in the historical record for every attempt made before the
//     feature that reads it exists.
// Backfilling any of the four later is not just a migration — it is
// unrecoverable data loss about what evidence actually looked like, because
// there is no way to reconstruct after the fact whether a hint was shown or a
// response was typed vs. spoken. Better to carry an always-`false`/
// always-`practice` column through this epic than to discover in E8/E9 that
// none of the earlier evidence can be classified.
//
// -----------------------------------------------------------------------------
// `sessionId` — nullable, and `onDelete: SetNull`, not `Cascade`
// -----------------------------------------------------------------------------
// Nullable because a mock-interview attempt (E8) has no practice session to
// belong to — there is no session row for it to reference. `SetNull` rather
// than `Cascade` because an attempt is EVIDENCE that a question was answered;
// deleting the session it happened to occur under (a housekeeping purge of
// old session summaries, say) must not silently delete the fact that the
// learner answered a question. The attempt survives with `sessionId: null`,
// exactly the same shape a mock-interview attempt already has.
//
// -----------------------------------------------------------------------------
// `PracticeAttempt.questionId` — `onDelete: Restrict`, matching
// `CivicsQuestion.testVersion`/`.category` above, not `CivicsAnswer.question`
// -----------------------------------------------------------------------------
// `CivicsAnswer` cascades from its question because an answer has no identity
// independent of the question it answers. A `PracticeAttempt` is the reverse
// relationship: the question is content the attempt is EVIDENCE ABOUT, and
// that evidence must not vanish because content was reloaded or a bad row
// removed. A question that has already been answered by a real learner
// cannot be deleted — the same historical-integrity reasoning `AuditEvent`
// and `NotificationDelivery` apply to their own subjects, applied here to
// content instead of to a user.
//
// -----------------------------------------------------------------------------
// `PracticeSession.testVersionCode` — `onDelete: Restrict`, matching
// `LearnerProfile.testVersion`
// -----------------------------------------------------------------------------
// A session records which bank of questions it was drawn from; a test
// version cannot be deleted out from under sessions (or profiles) still
// referencing it.
//
// -----------------------------------------------------------------------------
// `PracticeSession.categoryId` — nullable, `onDelete: SetNull`
// -----------------------------------------------------------------------------
// Only a `kind: category` session was started with a category filter — every
// other kind leaves this null. `SetNull` (not `Restrict`) because the
// category is a descriptive filter the session was started with, not a
// dependency the session's own integrity rests on: if a category is ever
// removed, the historical session record should keep existing with
// `categoryId: null` rather than block the deletion or vanish itself.
//
// -----------------------------------------------------------------------------
// `PracticeAttempt.userId` / `PracticeSession.userId` — both `onDelete: Cascade`
// -----------------------------------------------------------------------------
// Matches `AiUsageEvent.user` and `Notification.user` above: this is the
// user's own practice history with no reader once the account is gone, both
// columns are NOT NULL so `SetNull` is not expressible, and retaining a
// deleted person's answer history serves nobody.
//
// -----------------------------------------------------------------------------
// `gradingMethod` — a real enum, not a boolean or free string
// -----------------------------------------------------------------------------
// `exact` (typed-answer string match), `self` (learner self-reports "I knew
// it" on a flashcard-style reveal) and `ai` (E9/AI-graded free response) are
// three genuinely different grading pipelines with different trustworthiness
// as evidence — a readiness model weighing "self-graded" against
// "AI-graded" against "exact match" needs to tell them apart, the same
// closed-set reasoning `CivicsDynamicScope` and `JourneyStage` already apply
// above.
//
// -----------------------------------------------------------------------------
// `PracticeSession.summary` — JSONB, nullable
// -----------------------------------------------------------------------------
// Computed once at completion (score, per-category breakdown, timing) and
// persisted rather than recomputed from `attempts` on every read — the
// session's attempts are immutable evidence rows that should not need a
// live aggregation query every time a "past sessions" list renders. Null
// while `status: in_progress`, because there is nothing to summarize yet.

// The kind of run a session represents — a closed, code-owned set (the app's
// own practice-mode picker), not an open registry: `quick` (a short mixed
// drill), `category` (filtered to one `CivicsCategory`), `review` (spaced
// re-practice of previously seen questions), `weak` (targeted at questions
// with a poor attempt history), `mixed` (full-bank random draw).
enum PracticeSessionKind {
  quick
  category
  review
  weak
  mixed
}

// A session's own lifecycle — mirrors `DeviceCodeStatus`'s shape: a small,
// closed state machine owned entirely by the practice service.
// `abandoned` (as opposed to leaving it `in_progress` forever) matters
// because "sessions currently in progress" must mean sessions the learner is
// actually still in, not every session anyone ever navigated away from.
enum PracticeSessionStatus {
  in_progress
  completed
  abandoned
}

// See "FOUR COLUMNS THIS EPIC WRITES ONLY ONE VALUE OF" above.
enum PracticeAttemptSource {
  practice
  mock_interview
}

// See "FOUR COLUMNS THIS EPIC WRITES ONLY ONE VALUE OF" above.
enum PracticeInputMode {
  typed
  spoken
}

// See "FOUR COLUMNS THIS EPIC WRITES ONLY ONE VALUE OF" above.
enum PracticePromptMode {
  read
  heard
}

// The result of one attempt. `partial` covers a multi-answer question (e.g.
// "Name one branch of government") where the learner supplied a real but
// incomplete answer — distinct from `incorrect` (a wrong answer given) and
// `skipped` (no answer given at all), which a readiness model must be able
// to tell apart from each other.
enum PracticeOutcome {
  correct
  partial
  incorrect
  skipped
}

// See "gradingMethod" above.
enum PracticeGradingMethod {
  exact
  self
  ai
}

// -----------------------------------------------------------------------------
// AI Grading on `PracticeAttempt` (issue #110, epic #53)
// -----------------------------------------------------------------------------
// `gradingMethod: ai` (above) says an AI call happened. It does not say what
// the AI found. When an `ai`-graded response comes back `incorrect`, this
// enum is the grader's classification of WHY — the single fact
// `outcome`/`gradingMethod` cannot express, and the one PRD.md's readiness
// model and VISION.md's "we should never assume difficulty answering a
// question means a user is incapable" both need: a learner who has never
// heard of the fact and a learner who knows it cold but cannot get the
// English out are not the same failure, and treating them the same is
// exactly the false discouragement VISION.md warns against.
//
//   - `not_known` — the response is unrelated to any accepted answer. The
//     learner has never learned the fact; nothing in the response gestures
//     at it.
//   - `not_recalled` — the learner produced the wrong member of a set they
//     clearly recognise: a real branch of government when a different one
//     was asked for, a real former officeholder when the current one was
//     asked for. The shape of the answer is right; the specific fact
//     recalled is wrong.
//   - `expression` — THE CAUSE THIS PRODUCT EXISTS FOR. VISION.md: users
//     "know the answer but struggle to say it confidently" and "speak
//     English as a second language" — this is that user, captured as data.
//     The response demonstrably MEANS an accepted answer, but the English is
//     broken, partial, or mis-formed. Grading this as `not_known` would be
//     the exact harm VISION.md names; this value is what lets the product
//     tell the two apart and respond to them differently (more English
//     practice, not more civics content).
//   - `misheard` — the response answers a different question than the one
//     asked, consistent with mishearing the prompt rather than not knowing
//     the material. DECLARED NOW, PRODUCED STARTING IN E9: distinguishing
//     "misheard" from "not_known" needs the transcription confidence E9's
//     spoken-answer pipeline introduces, which does not exist yet. E3's
//     grader will simply never emit it — see the two-values-now note below.
//   - `nervous` — a self-correcting ramble, a false start, or an abandoned
//     attempt that contains the right idea before the learner talks
//     themselves out of it. DECLARED NOW, PRODUCED STARTING IN E8: telling
//     this apart from `not_recalled` needs the response-timing signal E8's
//     mock-interview engine introduces, which does not exist yet.
//   - `unknown` — the grader ran and could not confidently classify the
//     failure into any of the five causes above. This is the HONEST
//     DEFAULT, not a leftover bucket: forcing a model to always pick one of
//     the five manufactures a confident-sounding diagnosis out of a response
//     that genuinely does not support one, which is worse than admitting
//     uncertainty.
//
// `unknown` is a value the grader WRITES; a NULL `failureCause` column
// (below) means the grader never ran at all. Collapsing those two into one
// "no cause" state would erase the difference between "we have no idea why"
// and "we didn't even ask" — two different facts about the row, and a
// pipeline debugging silent AI-grading failures needs to tell them apart.
//
// Same reasoning as `PracticeAttempt`'s own `source`/`promptMode`/
// `inputMode`/`hintUsed` (issue #66, "FOUR COLUMNS THIS EPIC WRITES ONLY ONE
// VALUE OF" above): `misheard` and `nervous` are declared as real enum
// values now, while E3/E4 can only ever produce the other four, because the
// alternative is widening this enum AND retroactively guessing at every
// historical row's unclassifiable failures once E8/E9 ship. Two unused
// values cost nothing today; backfilling them later is not possible at all,
// because the evidence (timing, transcription confidence) that would let a
// grader distinguish them does not exist for a row graded before E8/E9.
enum PracticeFailureCause {
  not_known
  not_recalled
  expression
  misheard
  nervous
  unknown
}

// One row per practice run. journey-shell.md and PRD.md's "Practicing" stage
// are what this table backs: a learner drills a batch of questions, and this
// row is the header record for that batch.
model PracticeSession {
  id String @id @default(uuid()) @db.Uuid

  // onDelete: Cascade — see "userId ... both onDelete: Cascade" above.
  userId String @map("user_id") @db.Uuid

  kind PracticeSessionKind

  status PracticeSessionStatus @default(in_progress)

  // Which question bank this session was drawn from. onDelete: Restrict,
  // matching `LearnerProfile.testVersion` — a test version cannot be deleted
  // while sessions still reference it.
  testVersionCode String @map("test_version_code")

  // The category filter a `kind: category` session was started with.
  // Nullable because only `category` sessions have one — see
  // "PracticeSession.categoryId" above.
  categoryId String? @map("category_id") @db.Uuid

  plannedCount Int @map("planned_count")

  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz

  completedAt DateTime? @map("completed_at") @db.Timestamptz

  // See "PracticeSession.summary" above.
  summary Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user        User              @relation("UserPracticeSessions", fields: [userId], references: [id], onDelete: Cascade)
  testVersion CivicsTestVersion @relation(fields: [testVersionCode], references: [code], onDelete: Restrict)
  category    CivicsCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  attempts    PracticeAttempt[]

  // The Recent-sessions query: this user's sessions, newest first.
  @@index([userId, startedAt])
  @@map("practice_sessions")
}

// One row per question answered, from EITHER a practice session or (from E8
// onward) a mock interview. See the block comment above this model's enums
// for why this table is not nested under `PracticeSession` alone.
model PracticeAttempt {
  id String @id @default(uuid()) @db.Uuid

  // onDelete: Cascade — see "userId ... both onDelete: Cascade" above.
  userId String @map("user_id") @db.Uuid

  // onDelete: Restrict — see "PracticeAttempt.questionId" above: evidence
  // must not vanish because content was reloaded, and a question that has
  // been answered cannot be deleted.
  questionId String @map("question_id") @db.Uuid

  source PracticeAttemptSource @default(practice)

  // Nullable — see "sessionId" above. Null for an E8 mock-interview attempt,
  // which has no practice session; onDelete: SetNull so deleting a session
  // never cascades away the evidence rows it produced.
  sessionId String? @map("session_id") @db.Uuid

  // Nullable for the mirror-image reason `sessionId` above is: an ordinary
  // practice attempt has no interview to belong to. Set only when
  // `source: mock_interview` (issue #115, epic #57). onDelete: SetNull for
  // the IDENTICAL "evidence must outlive its bookkeeping" reason `sessionId`
  // and `aiUsageEventId` below already give: deleting a mock interview must
  // leave the attempts it produced intact with this FK cleared, because
  // mastery (#54) and readiness (#55) keep reading ONE `practice_attempts`
  // table with no UNION against a second, interview-only evidence table.
  mockInterviewId String? @map("mock_interview_id") @db.Uuid

  inputMode PracticeInputMode @default(typed) @map("input_mode")

  promptMode PracticePromptMode @default(read) @map("prompt_mode")

  // Null for a skip — there is no response to record.
  //
  // A SECOND, DISTINCT REASON THIS IS NULL (issue #115, epic #57): also null
  // for a mock-interview attempt (`source: mock_interview`) whose interview
  // has `transcriptRetained: false`. The outcome, grading method, failure
  // cause, and `answerSnapshot` are all retained exactly as for any other
  // attempt — the evidence a readiness/mastery read needs survives — but the
  // learner's own words deliberately do not, because a mock interview is the
  // most sensitive conversation this product records. See
  // `MockInterview.transcriptRetained` and
  // `docs/specs/mock-interview.md` §8 for the retention design in full.
  responseText String? @map("response_text") @db.Text

  outcome PracticeOutcome

  gradingMethod PracticeGradingMethod @map("grading_method")

  // -----------------------------------------------------------------------
  // AI grading output — all three NULLABLE, and each null for a DIFFERENT
  // reason (issue #110, epic #53)
  // -----------------------------------------------------------------------
  // These three columns are written together, by the same grading call, and
  // read together — they are grouped here rather than at the end of the
  // table so that "what did the grader decide" stays one block, next to
  // `gradingMethod`, which says whether a grader ran at all.
  //
  // NULL `failureCause`/`aiFeedback` means no grader ever ran for this
  // attempt — `gradingMethod` is `exact` or `self`, or grading failed before
  // producing output. `failureCause: unknown` means a grader DID run and
  // could not tell why the response was wrong. Collapsing "never asked" and
  // "asked, no answer" into one NULL would make it impossible to later ask
  // "how often is our grader unable to classify a failure?" — that question
  // needs the two states kept apart.
  //
  // NO BACKFILL. Every row written before this migration, and every row an
  // `exact`/`self`-graded attempt writes after it, is valid with all three
  // columns NULL — there is no historical AI verdict to reconstruct for a
  // response no grader ever looked at.

  // See `PracticeFailureCause` above for the full enum and each value's
  // definition and observable signal. NULL means no grader ran; `unknown`
  // means the grader ran and could not tell — those are different facts.
  failureCause PracticeFailureCause? @map("failure_cause")

  // The grader's STRUCTURED verdict only — `{ verdict, failureCause,
  // feedback }` — and NOTHING ELSE. Never the prompt sent to the model,
  // never the raw completion text, never any key material. The prompt is
  // reconstructable from `responseText` + `answerSnapshot` + the question at
  // any time and does not need to be frozen here; the raw completion is
  // exactly the kind of unbounded, ungoverned provider text `AiUsageEvent`'s
  // own comments already exclude from that table's columns for the same
  // reason. Keeping this column to the parsed verdict means a stored row can
  // never leak a credential or a provider's internal reasoning even if this
  // table is ever exported or displayed directly.
  aiFeedback Json? @map("ai_feedback")

  // Which `AiUsageEvent` row this attempt's grading call produced, so a
  // grading verdict can be traced back to its cost, latency, and
  // provider/model — the same relationship `AiUsageEvent` already exists to
  // answer, not a duplicate of it. Nullable because a non-`ai`-graded attempt
  // has no such call, and onDelete: SetNull (NOT Cascade, and NOT Restrict)
  // because this is the same "evidence must outlive its bookkeeping" shape as
  // `PracticeAttempt.sessionId` above: pruning old usage-history rows (a
  // retention job, an admin cleanup) must never destroy the graded attempt
  // that call produced. The attempt is the evidence; the usage row is
  // accounting for it.
  aiUsageEventId String? @map("ai_usage_event_id") @db.Uuid

  // Whether the correct answer was shown to the learner before (or instead
  // of) them answering — a flashcard-style reveal. Distinct from `hintUsed`:
  // a learner can reveal the full answer without ever seeing a partial hint,
  // and vice versa.
  revealed Boolean @default(false)

  // See "FOUR COLUMNS THIS EPIC WRITES ONLY ONE VALUE OF" above — PRD.md's
  // "ability to recall answers without hints" readiness signal.
  hintUsed Boolean @default(false) @map("hint_used")

  durationMs Int? @map("duration_ms")

  answeredAt DateTime @map("answered_at") @db.Timestamptz

  // The accepted answer(s) exactly as `CivicsAnswer` stood at grading time —
  // NOT a live join. `CivicsAnswer`'s dynamic-answer lifecycle (this file's
  // own comment on that model) means the correct answer to a `national` or
  // `state` question can change after this attempt was graded; freezing the
  // snapshot here is what lets a past attempt still be explained correctly
  // even after the officeholder it named has left office.
  answerSnapshot Json @map("answer_snapshot")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // NO `updatedAt`. An attempt is an immutable record of something that
  // already happened — same reasoning as `AiUsageEvent` above.

  // Relations
  user          User             @relation("UserPracticeAttempts", fields: [userId], references: [id], onDelete: Cascade)
  question      CivicsQuestion   @relation(fields: [questionId], references: [id], onDelete: Restrict)
  session       PracticeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  mockInterview MockInterview?   @relation(fields: [mockInterviewId], references: [id], onDelete: SetNull)
  aiUsageEvent  AiUsageEvent?    @relation("AiUsageEventPracticeAttempts", fields: [aiUsageEventId], references: [id], onDelete: SetNull)

  // Reverse lookup for `MockInterviewTurn.attemptId` (issue #115, epic
  // #57) — the applicant-turn "which graded attempt did this become"
  // reference. No `onDelete` to set here: the FK and its `SetNull` behavior
  // live on `MockInterviewTurn`, the owning side, matching how
  // `AiUsageEvent.practiceAttempts` above documents the identical shape.
  mockInterviewTurns MockInterviewTurn[]

  // The readiness model's core query: this user's history with this
  // question, in order — "has this learner ever answered this correctly,
  // and how has that changed over time?"
  @@index([userId, questionId, answeredAt])
  // Session detail view: all attempts belonging to one session.
  @@index([sessionId])
  // Interview detail view / readiness rollup: all attempts belonging to one
  // mock interview — the identical shape as the `sessionId` index above,
  // one row over.
  @@index([mockInterviewId])
  // Reverse lookup from a usage row to the attempt(s) it graded — the
  // AiUsageEvent side of the relationship this column exists to answer.
  @@index([aiUsageEventId])
  @@map("practice_attempts")
}

// =============================================================================
// Question Mastery (issue #71, epic #54 "Memory")
// =============================================================================
//
// One row per (user, question) — the live spaced-repetition state the
// scheduler (`nextSchedule`, issue #75) reads and writes on every attempt.
// `PracticeAttempt` above is the immutable evidence ledger, one row per
// answer, ever; this table is the DERIVED, MUTABLE summary of that ledger for
// a single question — "where does this learner stand on this fact right
// now?" — which is a different question than "what happened, when", and
// answering it by re-aggregating `practice_attempts` on every read (the
// review queue, PRD.md's readiness surfaces) does not scale the way one
// row read by primary key does.
//
// A row exists here ONLY once a question has been attempted at least once —
// see `state: new` below. There is no row for a question the learner has
// never seen.
//
// -----------------------------------------------------------------------------
// state — a real Postgres enum, matching this schema's convention for a
// small, closed, code-owned state machine (`JourneyStage`,
// `PracticeSessionStatus`, `DeviceCodeStatus`)
// -----------------------------------------------------------------------------
// The five SM-2-style buckets the scheduler moves a row through:
//   - `new` — never attempted. Doubles as the schema-level default for a
//     column with no committed answers yet; because this table is only ever
//     inserted with a real attempt behind it (see above), no row is actually
//     read back in this state today — the scheduler's insert already knows
//     the true state from the first outcome. It exists as a value (not
//     omitted) because a per-question mastery row is a natural future target
//     for being created eagerly (e.g. when content loads) ahead of any
//     attempt, and the enum should already have a name for that day one.
//   - `learning` — attempted, not yet a stable, spaced-out interval.
//   - `review` — graduated to spaced review; the ordinary steady state for a
//     fact the learner knows.
//   - `lapsed` — was known, then missed; the scheduler's signal to
//     re-teach rather than merely re-review.
//   - `mastered` — sustained correct recall over time (this migration's own
//     backfill uses "correct on >= 3 distinct calendar days" as its proxy;
//     `nextSchedule`, issue #75, owns the real, live promotion rule).
//
// -----------------------------------------------------------------------------
// ease / interval_days / due_at — the SM-2-style scheduling triple
// -----------------------------------------------------------------------------
// `ease` starts at 2.5 (the canonical SM-2 default: every card starts at
// "normal" difficulty, and each grade nudges it up or down) and
// `interval_days` at 0 (an ungraduated card has no spacing yet — the very
// next attempt is what sets one). `due_at` is nullable because a `new` row
// (see above) has nothing scheduled; every other state carries a real
// due date once `nextSchedule` (issue #75) has run at least once.
//
// `ease` is `@db.DoublePrecision`, not `Decimal`: SM-2's ease factor is a
// heuristic multiplier fed back into arithmetic on every review (never
// summed, never compared for exact equality, never shown to a user as
// currency-like data) — the one case `Decimal`'s exactness earns its cost is
// none of those, and a plain float keeps every scheduler calculation in
// ordinary floating-point math with no cast at each read.
//
// -----------------------------------------------------------------------------
// last_outcome — reuses `PracticeOutcome`, not a new enum
// -----------------------------------------------------------------------------
// The four values a `practice_attempts` row can already carry
// (correct/partial/incorrect/skipped) are exactly what "the most recent
// attempt's result" means here too — inventing a second, parallel enum for
// the same four-value set would be the same duplication this schema's other
// comments (`AiUsageEvent.roleKey`, the notification registry) argue against
// elsewhere, just moved from a code registry to an enum. Nullable because a
// row created ahead of any attempt (see `state: new` above) has no outcome
// yet to report.
//
// -----------------------------------------------------------------------------
// distinct_correct_days — why a COUNT OF DAYS, not a COUNT OF ATTEMPTS
// -----------------------------------------------------------------------------
// VISION.md's "never create artificial confidence after a few successful
// answers" (already quoted at length on `PracticeAttempt` above) is exactly
// what a plain correct-attempt counter would violate: five correct answers
// inside one ten-minute drill session would count the same as five correct
// answers spread across five separate days, and only the second is real
// evidence of durable recall. Counting distinct calendar dates is the
// cheapest column-level proxy for "spaced" recall available without
// re-deriving it from `practice_attempts` on every read.
//
// -----------------------------------------------------------------------------
// onDelete — Cascade on both FKs, matching `PracticeAttempt.userId` /
// `.questionId`'s own reasoning ONE OF THE TWO WAYS, DELIBERATELY DIFFERENT
// ON THE OTHER
// -----------------------------------------------------------------------------
// `userId`: Cascade, identical reasoning to every other per-user table in
// this schema (`AiUsageEvent`, `Notification`, `PracticeAttempt` itself) —
// this is derived state with no reader once the account is gone.
//
// `questionId`: Cascade here, UNLIKE `PracticeAttempt.questionId`'s
// `Restrict`. That asymmetry is intentional, not an oversight: a
// `PracticeAttempt` is immutable EVIDENCE that must survive content changes
// (the comment on that column says so explicitly), so content the schema
// cares about protecting cannot be deleted out from under it. A
// `QuestionMastery` row is the opposite — purely DERIVED scheduling state
// with no independent meaning once the question it tracks is gone. Requiring
// `Restrict` here would additionally block the exact content deletion
// `PracticeAttempt.questionId`'s own comment says must already be blocked by
// that column — so this FK cannot be the thing standing in the way; it
// should just quietly disappear alongside the row it was scheduling.
model QuestionMastery {
  id String @id @default(uuid()) @db.Uuid

  userId     String @map("user_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid

  state MasteryState @default(new)

  dueAt        DateTime? @map("due_at") @db.Timestamptz
  intervalDays Int       @default(0) @map("interval_days")
  ease         Float     @default(2.5) @db.DoublePrecision

  correctStreak Int @default(0) @map("correct_streak")
  lapses        Int @default(0)
  totalAttempts Int @default(0) @map("total_attempts")

  distinctCorrectDays Int @default(0) @map("distinct_correct_days")

  lastOutcome   PracticeOutcome? @map("last_outcome")
  lastAttemptAt DateTime?        @map("last_attempt_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user     User           @relation("UserQuestionMastery", fields: [userId], references: [id], onDelete: Cascade)
  question CivicsQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // One mastery row per (user, question) — the upsert key `nextSchedule`
  // (issue #75) writes through on every graded attempt.
  @@unique([userId, questionId])
  // The review queue's core query: this user's due cards, oldest-due first.
  @@index([userId, dueAt])
  @@map("question_mastery")
}

// See `QuestionMastery.state` above for what each value means and why `new`
// is declared but not read back by anything in this migration's own backfill.
enum MasteryState {
  new
  learning
  review
  lapsed
  mastered
}

// =============================================================================
// Readiness Snapshots (issue #113, epic #55 "Readiness and Progress")
// =============================================================================
//
// One row per computation of `computeReadiness` (`readiness-model.md` §5,
// issue #122) — a SNAPSHOT, not a live-computed view. `PracticeAttempt` is
// the immutable evidence ledger and `QuestionMastery` is the live, mutable
// per-question summary of it; this table is a third, different thing again:
// a point-in-time, self-contained record of what the readiness engine said
// on the day it ran, frozen so that a learner (or a future admin report)
// looking back at last Tuesday's number sees exactly what last Tuesday's
// number meant, even after the `question_mastery` rows it summarized have
// since been re-scheduled, lapsed, or re-promoted underneath it. Re-deriving
// the score on every read would silently re-describe today's evidence under
// yesterday's date — see `readiness-model.md` §4/§12 for the full rejected
// alternative.
//
// `userId`: Cascade, the identical posture every other per-learner table in
// this schema already takes (`PracticeAttempt.userId`, `QuestionMastery.userId`)
// — a snapshot has no meaning independent of the account it summarizes.
model ReadinessSnapshot {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  computedAt DateTime @map("computed_at") @db.Timestamptz

  // `round(weightedSum * 100)` — an integer 0-100 chosen specifically for
  // display: a UI renders "72," never "0.7182," and storing the
  // already-rounded integer means every reader of this table (the home
  // widget, the trend line, a future admin report) renders the identical
  // number with no re-rounding step of its own to keep in sync with the
  // engine's.
  score Int

  // The learner's `JourneyStage` at the moment this snapshot was computed —
  // reuses the same enum `LearnerProfile.stage` carries, not a duplicate,
  // so a snapshot can be read back later as "this was their stage when this
  // score was true" without joining out to a `learner_profiles` row whose
  // `stage` may have since moved on.
  stage JourneyStage

  // The FULL per-component breakdown — `ReadinessComponentResult` (`{
  // value, weight, contribution }`, readiness-model.md §5) for every one of
  // the eight `ReadinessComponentKey`s. Stored as `Json` (application-typed,
  // not schema-typed) because the shape is a fixed TypeScript interface the
  // pure engine already owns and validates — see `PracticeAttempt.aiFeedback`
  // above for the same posture on the same reasoning. Kept alongside
  // `evidenceCounts` below so a rendered snapshot stays self-explaining
  // forever, even after the underlying evidence changes later.
  components Json

  // The raw per-component evidence counts §5's `evidenceCounts` shape
  // defines (e.g. `{ distinctQuestionsAttempted, totalQuestionsInVersion }`
  // for `coverage`) — the numbers `components` above were computed FROM, not
  // a duplicate of the result. Frozen for the identical reason `components`
  // is: so this snapshot's numbers stay meaningful after `question_mastery`
  // and `practice_attempts` move on underneath it.
  evidenceCounts Json @map("evidence_counts")

  // Nullable `String`, not a Prisma enum — deliberately UNLIKE `MasteryState`
  // /`JourneyStage`. Its one live value, `'typed_only'` (readiness-model.md
  // §3), is not expected to grow into a genuinely open-ended set the way
  // those two are; the closed TypeScript union `CapReason` is the real
  // contract, enforced at the application layer, the same posture
  // `PracticeAttempt.aiFeedback`'s `Json?` column takes relative to its own
  // application-level shape. `null` means the cap has lifted — real evidence
  // of spoken practice or a mock interview exists — NOT that every component
  // is complete; see §3 for why those are deliberately different questions.
  capReason String? @map("cap_reason")

  // `ReadinessTopRecommendation` (`{ componentKey, title, reason, path }`,
  // §8.2) — the single next action this snapshot recommends. `Json`, not
  // nullable: `computeReadiness` always produces exactly one recommendation
  // (the cap message itself, when capped; otherwise the component with the
  // greatest weighted headroom), so there is no "no recommendation" state
  // for this column to represent.
  topRecommendation Json @map("top_recommendation")

  // The Progress Guide's one AI-generated paragraph (issue #134, §9).
  // Nullable and filled in LAZILY, after the snapshot row already exists —
  // its absence must never block snapshot creation, exactly as `AiFeedback`
  // above is populated by a call that happens after (and independently of)
  // the row it augments. Absent without complaint when AI is unavailable.
  narrative String? @db.Text

  // When `narrative` was generated, so a caller can tell "never generated"
  // (both null) apart from "generated once, on this date" without inferring
  // it from `narrative`'s mere presence — and so a future re-generation
  // policy (e.g. "regenerate if stale") has a timestamp to compare against.
  narrativeGeneratedAt DateTime? @map("narrative_generated_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation("UserReadinessSnapshots", fields: [userId], references: [id], onDelete: Cascade)

  // The home widget's and trend line's core query: this user's snapshots,
  // most-recent-first (or a range over `computedAt`) — the same
  // `[userId, <ordering column>]` shape `PracticeSession`/`QuestionMastery`
  // already index for their own "this user's rows, in time order" reads.
  @@index([userId, computedAt])
  @@map("readiness_snapshots")
}

// =============================================================================
// Daily Activity & Streak Freezes (issue #112, epic #56 "Habit")
// =============================================================================
//
// One row per (user, LOCAL calendar day) — the ledger a streak is counted
// from. This is deliberately a FOURTH kind of per-learner table, next to the
// three `ReadinessSnapshot`'s own header comment already distinguishes:
// `PracticeAttempt` is immutable evidence per QUESTION, `QuestionMastery` is
// derived scheduling state per QUESTION, `ReadinessSnapshot` is a frozen
// point-in-time SCORE. `DailyActivity` is none of those — it is a rollup per
// DAY, the grain a streak ("how many days in a row") is actually counted in,
// and no combination of the other three answers "did this learner show up
// today" without re-deriving a calendar-day boundary from timestamps on every
// read, in every caller, forever.
//
// -----------------------------------------------------------------------------
// activity_date — `@db.Date`, the SAME reasoning as `LearnerProfile.interviewDate`,
// and the ONLY OTHER `@db.Date` COLUMN IN THIS SCHEMA
// -----------------------------------------------------------------------------
// "Did this learner practise today" is a question about a LOCAL calendar day
// in `learner_profiles.timezone`, not a UTC window — exactly the distinction
// `LearnerProfile.interviewDate`'s own comment draws for a booked interview
// ("an interview is booked for a day, not an instant"). A `@db.Timestamptz`
// column would be wrong here for the identical reason it would be wrong
// there: a learner in `America/Los_Angeles` who practises at 11:30 PM is
// still practising on THEIR Tuesday, and storing an instant would force every
// reader to re-derive the day boundary from a timezone that can itself change
// later (see `tzUsed` immediately below). Storing the day itself, already
// resolved, is what makes every later read of this table a plain date
// comparison instead of a per-row timezone calculation.
//
// -----------------------------------------------------------------------------
// tz_used — STORED, not derived at read time
// -----------------------------------------------------------------------------
// The IANA zone the day boundary was actually computed in, frozen onto the
// row at write time rather than looked up fresh from `learner_profiles.timezone`
// whenever this table is read. That distinction matters the moment a learner's
// timezone changes: a learner who logs their Tuesday practice while in
// `America/Los_Angeles` and later moves their profile to `Europe/Madrid` must
// not have that old Tuesday reinterpreted under Madrid's clock — the
// boundary that decided "which day was this" is a fact about the moment the
// row was written, not about whatever the profile says today. Re-deriving it
// live would silently rewrite history every time a learner's `timezone`
// changes, exactly the failure mode `ReadinessSnapshot`'s own header comment
// rejects for readiness scores ("re-deriving the score on every read would
// silently re-describe today's evidence under yesterday's date"), applied
// here to which day evidence belongs to instead of what it's worth.
//
// -----------------------------------------------------------------------------
// goal_met — a Boolean, and MONOTONIC: once true it never flips back
// -----------------------------------------------------------------------------
// A day either reached the learner's `dailyGoalMinutes` or it didn't, but the
// column is written progressively as practice accrues through the day — the
// monotonic rule is what keeps a later write from ever un-setting a goal
// already met earlier the same day (e.g. a session-abandon path that
// recomputes partial progress). Once `true`, an accrual write may only leave
// it `true` or extend `practiceSeconds`/`attempts`/`correct` further; it may
// never set it back to `false` for the same row.
//
// -----------------------------------------------------------------------------
// freeze_used — WHY THIS ROW CAN EXIST WITH ZERO PRACTICE AT ALL
// -----------------------------------------------------------------------------
// Every other column on this table describes practice that happened.
// `freezeUsed` describes the opposite case: a day with `attempts = 0` and
// `goalMet = false` that settlement has decided to COVER with one of the
// learner's `LearnerProfile.streakFreezes`, so the streak counter does not
// reset over it. Persisting that consumption ON THE UNIQUE KEY below (rather
// than, say, only decrementing `streakFreezes` and leaving no per-day record)
// is what makes two things true at once: settlement is an UPSERT, so running
// it twice for the same missed day spends the freeze once, not twice
// (idempotency), and the learner's own history stays fully auditable — a
// later "why did my streak survive that gap" view has a real row to read,
// not just a decremented counter with no explanation of which day it paid
// for.
//
// -----------------------------------------------------------------------------
// The unique key IS the idempotency mechanism, for BOTH writers
// -----------------------------------------------------------------------------
// `@@unique([userId, activityDate])` is what turns ordinary accrual (practice
// happening throughout a day) into an UPSERT rather than an ever-growing
// append-only log of partial progress — the same row is found and added to
// on every attempt within one calendar day. It is also what makes freeze
// settlement idempotent for exactly the reason above: a retried or re-run
// settlement job resolves to the same row via this key rather than double
// spending a freeze or creating a duplicate "missed day" record.
//
// -----------------------------------------------------------------------------
// NO PATH FROM THIS TABLE TO THE READINESS ENGINE — ENFORCED HERE AS A RULE,
// NOT LEFT TO CONVENTION
// -----------------------------------------------------------------------------
// This table has no foreign key, no relation, and no column that lets
// `readiness_snapshots` or `computeReadiness` (`readiness-model.md` §5) read
// out of `daily_activity`. That is deliberate and this comment is the rule,
// not just a description of the current state: engagement (did the learner
// show up) and readiness (is the learner ready for the test) are answering
// two different questions PRD.md and VISION.md keep separate on purpose — a
// streak measures habit, not competence, and letting a readiness component
// read a streak would let mere attendance inflate a score meant to reflect
// demonstrated recall. Any future change that wires this table into the
// readiness engine is a product decision that must be made explicitly and
// documented there, never introduced quietly as a schema convenience here.
//
// `userId`: `onDelete: Cascade`, identical posture to every other per-learner
// table in this schema (`PracticeAttempt.userId`, `QuestionMastery.userId`,
// `ReadinessSnapshot.userId`) — a day's activity rollup has no meaning
// independent of the account it summarizes.
model DailyActivity {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  // The learner's LOCAL calendar day — see "activity_date" above for why this
  // is `@db.Date` and not `@db.Timestamptz`.
  activityDate DateTime @map("activity_date") @db.Date

  // The IANA zone this row's day boundary was actually computed in, frozen at
  // write time — see "tz_used" above for why this is stored rather than
  // re-derived from the learner's (possibly since-changed) profile timezone.
  tzUsed String @map("tz_used")

  practiceSeconds Int @default(0) @map("practice_seconds")
  attempts        Int @default(0)
  correct         Int @default(0)

  // See "goal_met" above — monotonic: once true, never flips back to false
  // for the same row.
  goalMet Boolean @default(false) @map("goal_met")

  // See "freeze_used" above — true only when this row exists to record that
  // a streak freeze covered a day with no practice at all.
  freezeUsed Boolean @default(false) @map("freeze_used")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User @relation("UserDailyActivity", fields: [userId], references: [id], onDelete: Cascade)

  // The idempotency key for BOTH writers (ordinary accrual and freeze
  // settlement) — see "The unique key IS the idempotency mechanism" above.
  // This composite index already serves the descending streak walk below
  // ("give me this user's most recent days, going backward, until the streak
  // breaks"): Postgres can walk a `(userId, activityDate)` B-tree backwards
  // as cheaply as forwards, so a second, separately-declared index over the
  // same two columns would duplicate this one for no read this table
  // actually needs to serve. No `@@index` is added beneath it for that
  // reason — it would earn no query the unique index doesn't already answer.
  @@unique([userId, activityDate])
  @@map("daily_activity")
}

// =============================================================================
// Mock Interviews — Text Mode (issue #115, epic #57 "Mock Interview")
// =============================================================================
//
// Full design: docs/specs/mock-interview.md. This comment is the pointer for
// what is genuinely load-bearing about the SCHEMA; the transcript format,
// phase sequencing, and debrief shape live in that document, not duplicated
// here.
//
// A mock interview simulates the N-400 naturalization interview end to end —
// small talk, the N-400 review, the civics questions, (E10) reading and
// writing, and closing — as one continuous conversation between an "officer"
// (the AI) and the "applicant" (the learner). `MockInterview` is the header
// row for one such run; `MockInterviewTurn` is one line of that
// conversation, in order.
//
// This is deliberately NOT a third, parallel copy of
// `PracticeSession`/`PracticeAttempt` for the civics portion. The civics
// questions asked during an interview are graded and recorded through the
// SAME `practice_attempts` table `PracticeSession` already writes into
// (`source: mock_interview`, `sessionId: null`) — see that enum's own "FOUR
// COLUMNS THIS EPIC WRITES ONLY ONE VALUE OF" comment above, which named
// this exact table one epic ahead of this one. `MockInterview` and
// `MockInterviewTurn` exist to record the INTERVIEW STRUCTURE — the
// conversational shell around that evidence — not to duplicate the evidence
// itself. One evidence table, one readiness query, same as
// `PracticeAttempt`'s own header comment already argues for practice vs.
// interview attempts generally.

// `voice` is declared now, unwired: E8 (this epic) only ever writes `text`.
// E9/E11 add spoken interviews by changing the TRANSPORT the same turns flow
// through, not by adding a column here — the same "declare the full set
// while the table is empty" reasoning `PracticeAttemptSource.mock_interview`
// and `PracticeSessionKind`'s `review`/`weak`/`mixed` already apply to their
// own enums, one epic ahead of the epic that wires each value.
enum MockInterviewMode {
  text
  voice
}

// Mirrors `PracticeSessionStatus`'s three-value shape and reasoning verbatim:
// `abandoned` (as opposed to leaving an interview `in_progress` forever) is
// what makes "interviews currently in progress" mean interviews the learner
// is actually still in, not every interview anyone ever navigated away from.
enum MockInterviewStatus {
  in_progress
  completed
  abandoned
}

enum MockInterviewTurnRole {
  officer
  applicant
}

// The sections of a real N-400 interview, in the order they occur. `reading`
// and `writing` are declared now even though E8 skips them — E10 supplies
// their content and behavior; this enum simply names the phases, the same
// "declare the full closed set before every value is wired" posture
// `MockInterviewMode.voice` above and `PracticeFailureCause`'s `misheard`/
// `nervous` values already take.
enum MockInterviewPhase {
  smalltalk
  n400
  civics
  reading
  writing
  closing
}

// One row per mock interview run — the header record for the conversation
// `MockInterviewTurn` rows narrate line by line, mirroring how
// `PracticeSession` is the header record for a batch of `PracticeAttempt`
// rows.
model MockInterview {
  // This id is not only the row's identity — it is ALSO the deterministic
  // seed the interview engine shuffles the question pool with, so replaying
  // the SAME interview (a resumed session, a debrief re-render) always
  // produces the same questions in the same order from the same seed. A
  // genuinely load-bearing second use of the primary key, not a coincidence
  // worth losing sight of.
  id String @id @default(uuid()) @db.Uuid

  // onDelete: Cascade — see `PracticeSession.userId`'s own "both onDelete:
  // Cascade" reasoning above: this is the user's own history with no reader
  // once the account is gone.
  userId String @map("user_id") @db.Uuid

  mode MockInterviewMode @default(text)

  status MockInterviewStatus @default(in_progress)

  // Which question bank (and pass rule) this interview is drawn from and
  // graded against. NON-NULL, unlike `LearnerProfile.testVersionCode` — an
  // interview without a resolvable pass rule must be unrepresentable, because
  // `passedCivics` below is computed FROM this row's threshold, never from a
  // constant duplicated at the call site. onDelete: Restrict, matching
  // `PracticeSession.testVersion` — a test version cannot be deleted while
  // interviews still reference it.
  testVersionCode String @map("test_version_code")

  // FROZEN AT START TIME from `learner_profiles.senior_exemption`,
  // deliberately NOT re-read at complete time: which pair of columns on the
  // test-version row governs this interview (`questions_asked`/
  // `pass_threshold` vs. `senior_questions_asked`/`senior_pass_threshold`)
  // must not change halfway through an interview because the learner edited
  // their profile in another tab mid-session. Same "frozen at write time"
  // reasoning `DailyActivity.tzUsed` already states for a different column.
  seniorExemption Boolean @default(false) @map("senior_exemption")

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  // The DERIVED running tally of the civics portion — not a second source of
  // truth. The `practice_attempts` rows carrying this interview's id (via
  // `mockInterviewId`, `source: mock_interview`) are the evidence; these
  // three columns exist so the readiness query and the in-progress UI can
  // read a running count by primary key instead of re-aggregating attempts
  // on every read — the identical "derived, mutable summary of an immutable
  // ledger" argument `QuestionMastery`'s own header comment makes, applied
  // here to one interview instead of one (user, question) pair.
  civicsAsked   Int     @default(0) @map("civics_asked")
  civicsCorrect Int     @default(0) @map("civics_correct")
  passedCivics  Boolean @default(false) @map("passed_civics")

  // The cached debrief, written once at completion — score, per-phase
  // breakdown, feedback. Mirrors `PracticeSession.summary`'s own reasoning
  // exactly (computed once and persisted rather than recomputed from turns
  // and attempts on every read): nullable because an in-progress interview
  // has nothing to summarize yet.
  result Json?

  // A per-interview CHOICE the learner makes BEFORE starting — not a user
  // setting, and not read from `user_settings`. Whether this interview's
  // applicant turns keep the learner's own words (see
  // `MockInterviewTurn.text` below) or are recorded structurally-only.
  //
  // `@default(false)` IS THE SAFETY PROPERTY, ENFORCED AT THE DATABASE
  // LEVEL, NOT ONLY IN APPLICATION CODE. A mock interview is the most
  // sensitive conversation this product records — a rehearsal of exactly the
  // words an applicant plans to say to a federal immigration officer. If a
  // code path ever forgets to pass this flag explicitly (a bug, a new entry
  // point, a script), the column itself still refuses to retain the
  // learner's words by default. The conservative stance must survive a bug,
  // not merely a correctly-written call site.
  transcriptRetained Boolean @default(false) @map("transcript_retained")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user        User                @relation("UserMockInterviews", fields: [userId], references: [id], onDelete: Cascade)
  testVersion CivicsTestVersion   @relation(fields: [testVersionCode], references: [code], onDelete: Restrict)
  turns       MockInterviewTurn[]
  attempts    PracticeAttempt[]

  // The learner's interview list, newest first — mirrors `PracticeSession`'s
  // own `[userId, startedAt]` index exactly, same shape, same reason.
  @@index([userId, startedAt])
  // The readiness count `readiness.service.ts` reads directly: completed,
  // passed interviews for one user — an equality filter on all three
  // columns, not a range, so this composite serves it without a sort.
  @@index([userId, status, passedCivics])
  @@map("mock_interviews")
}

// One row per line of a mock interview's conversation, in order — the
// narration `MockInterview` above is the header record for.
model MockInterviewTurn {
  id String @id @default(uuid()) @db.Uuid

  // onDelete: Cascade — a turn has no identity independent of the interview
  // it belongs to, the same "no identity independent of its parent" posture
  // `CivicsAnswer.question` already takes toward its own question.
  mockInterviewId String @map("mock_interview_id") @db.Uuid

  // This interview's turns, in order. The unique constraint below is both
  // the ordering guarantee and the idempotency key a resumed/replayed
  // interview writes through.
  turnIndex Int @map("turn_index")

  role MockInterviewTurnRole

  // Named `phase`, not `kind` — `kind` already means something else one
  // table over (`PracticeSession.kind`, the practice-run type), and reusing
  // it here for a different concept on a neighboring table is exactly the
  // ambiguity this schema's naming otherwise avoids. `@map("phase")` because
  // that is genuinely what this column is: which section of the interview
  // this turn belongs to.
  phase MockInterviewPhase @map("phase")

  // Set only on a civics OFFICER turn — which question was read aloud. Null
  // on every other turn (small talk, N-400, closing, and every applicant
  // turn). onDelete: Restrict, matching `PracticeAttempt.questionId` above:
  // a question that has already been asked in a real interview transcript
  // cannot be deleted out from under that record.
  //
  // Nullable and independent of `MockInterviewTurn.text` on purpose: this is
  // what lets a transcript still name WHICH question was asked even when
  // `transcriptRetained` is false and the applicant's own words are not
  // kept.
  questionId String? @map("question_id") @db.Uuid

  // Set only on a civics APPLICANT turn — which `practice_attempts` row this
  // turn's answer was graded into. Nullable for the same reason
  // `questionId` is: only civics applicant turns have one. onDelete:
  // SetNull, matching `PracticeAttempt.sessionId`'s own "evidence must
  // outlive its bookkeeping" reasoning: pruning a turn (or the interview it
  // belongs to) must never delete the graded attempt it produced.
  attemptId String? @map("attempt_id") @db.Uuid

  // MAY BE EMPTY, AND EMPTY IS MEANINGFUL, NOT A BUG. With
  // `mockInterview.transcriptRetained = false`, an applicant turn is written
  // with `text: ""` deliberately — the interview's STRUCTURE (that a turn
  // happened, in this phase, in this order, possibly naming a question via
  // `questionId` or an outcome via `attemptId`) survives so the transcript
  // still renders and the debrief still makes sense, while the learner's own
  // words do not. See `PracticeAttempt.responseText`'s own comment (extended
  // for this same reason) and `docs/specs/mock-interview.md` §8 for the
  // retention design in full.
  text String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // NO `updatedAt` — a turn is an immutable record of something that already
  // happened, same reasoning as `PracticeAttempt` above.

  // Relations
  mockInterview MockInterview    @relation(fields: [mockInterviewId], references: [id], onDelete: Cascade)
  question      CivicsQuestion?  @relation(fields: [questionId], references: [id], onDelete: Restrict)
  attempt       PracticeAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  // Ordering + idempotency key: one turn per (interview, index).
  // `[mockInterviewId, turnIndex]` as a separate `@@index` would be
  // redundant with this unique constraint — Postgres already serves both the
  // uniqueness check and an ordered scan from the same underlying index, the
  // same "no second index over the same columns" reasoning `DailyActivity`'s
  // own unique-key comment gives.
  @@unique([mockInterviewId, turnIndex])
  // The reverse lookup from a graded attempt to the turn it came from —
  // matches how `PracticeAttempt` itself indexes `aiUsageEventId` for the
  // identical reverse-lookup shape.
  @@index([attemptId])
  @@map("mock_interview_turns")
}
